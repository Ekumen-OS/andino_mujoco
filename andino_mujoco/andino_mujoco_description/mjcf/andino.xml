    <!-- Interface -->
    <actuator>
        <!-- actuator range in radians/sec: w=v_max/radius = 0.2/0.03.
             kv=10 is a deliberate compromise: kv=20 closed the steady-state
             velocity gap to <1 % but its transient torque (kv*Δω/r) saturated
             the wheel-floor friction cone during sudden velocity step changes,
             producing ~28 % rotation slip. Pairing kv=10 with wheel μ=4.0 keeps
             the actuator from over-driving the contact while still giving
             acceptable tracking. -->
        <velocity name="right-motor" joint="right_wheel_joint" kv="10" ctrllimited="false"/>
        <velocity name="left-motor" joint="left_wheel_joint" kv="10" ctrllimited="false"/>
    </actuator>

